# Dockerfile for cvcpkg-server production
#
# Multi-stage build for a smaller final image.
#
# PYTHON_DEPS selects how the server's Python runtime dependency closure is
# provisioned:
#   poetry  (default) — from PyPI via poetry (the historical path).
#   cvcpkg            — from cvcpkg.org via `cvcpkg install` (self-hosting: the
#                       server runs on the very Python closure cvcpkg built and
#                       published, incl. the noarch + per-interpreter fan-out
#                       packages).  Requires that closure to be live on
#                       CVCPKG_SERVER_URL.
#
# Build:
#   docker build -f Dockerfile.production -t cvcpkg-server:latest .
#   docker build -f Dockerfile.production --build-arg PYTHON_DEPS=cvcpkg \
#     [--build-arg CVCPKG_SERVER_URL=https://cvcpkg.org] -t cvcpkg-server:self .
#
# Run (requires CVCPKG_DATABASE_URL):
#   docker run -p 8420:8420 -e CVCPKG_DATABASE_URL=postgresql+asyncpg://... \
#     cvcpkg-server:latest

ARG PYTHON_DEPS=poetry

# ── Build stage ─────────────────────────────────────────────────
FROM python:3.12-slim AS builder
ARG PYTHON_DEPS
# Where the self-hosting path pulls the runtime closure from.
ARG CVCPKG_SERVER_URL=https://cvcpkg.org

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
        ca-certificates \
    && rm -rf /var/lib/apt/lists/*

COPY . .

ENV POETRY_HOME=/opt/poetry \
    POETRY_VERSION=1.8.2 \
    POETRY_VIRTUALENVS_CREATE=false

# poetry path: install the production closure from PyPI into the image's own
# site-packages. Leaves /opt/pydeps empty (created below so the COPY is valid).
RUN if [ "$PYTHON_DEPS" = "poetry" ]; then \
      curl -sSL https://install.python-poetry.org | python3 - && \
      ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry && \
      poetry install --no-interaction --no-ansi --no-root --only main -E production ; \
    fi

# cvcpkg (self-hosting) path: bootstrap the cvcpkg CLI (its own deps come from
# PyPI, but that is build tooling only), then use it to install the SERVER'S
# runtime closure from cvcpkg.org into /opt/pydeps — a self-contained prefix
# carrying python3.12 + every runtime dependency. Finally graft the cvcpkg code
# into that prefix (--no-deps: the deps are already the cvcpkg-provisioned ones)
# so the `cvcpkg-server` entrypoint exists there.  cvcpkg install resolves the
# full transitive closure, so only the direct roots (main + `production` extra +
# the interpreter) are listed.
RUN mkdir -p /opt/pydeps && \
    if [ "$PYTHON_DEPS" = "cvcpkg" ]; then \
      pip install --no-cache-dir . && \
      CVCPKG_SERVER_URL="$CVCPKG_SERVER_URL" cvcpkg install \
        python312 \
        pyyaml click cryptography greenlet httpx sqlalchemy \
        fastapi uvicorn pydantic python-multipart asyncpg alembic \
        --prefix /opt/pydeps --platform linux --arch x86_64 && \
      /opt/pydeps/bin/python3.12 -m pip install --no-deps --no-cache-dir . ; \
    fi

# ── Final stage: poetry variant ─────────────────────────────────
# The runtime is the base image's own python + the PyPI-installed site-packages.
FROM python:3.12-slim AS final-poetry
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
ENV CVCPKG_SERVER_BIN=cvcpkg-server \
    PYTHONPATH=/app

# ── Final stage: cvcpkg (self-hosting) variant ──────────────────
# The runtime is the cvcpkg-provisioned prefix (its own python3.12 + closure +
# the grafted cvcpkg code). No PyPI wheels ship in the final image.
FROM python:3.12-slim AS final-cvcpkg
COPY --from=builder /opt/pydeps /opt/pydeps
ENV PATH=/opt/pydeps/bin:${PATH} \
    CVCPKG_SERVER_BIN=/opt/pydeps/bin/cvcpkg-server

# ── Final stage: selected by PYTHON_DEPS ────────────────────────
FROM final-${PYTHON_DEPS} AS final
ARG PYTHON_DEPS
ARG CVCPKG_RELEASE=unknown
ENV CVCPKG_RELEASE=${CVCPKG_RELEASE}
ARG GITHUB_REPO=transfix/libcvc-deps
LABEL org.opencontainers.image.title="cvcpkg-server" \
      org.opencontainers.image.source="https://github.com/${GITHUB_REPO}" \
      org.opencontainers.image.version="${CVCPKG_RELEASE}"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash cvcpkg

# Application code.
COPY --chown=cvcpkg:cvcpkg . .

# poetry path installs the cvcpkg package into the image python here; the cvcpkg
# path already grafted it into /opt/pydeps in the builder.
RUN if [ "$PYTHON_DEPS" = "poetry" ]; then pip install --no-cache-dir -e ".[production]"; fi

# Data directories.
RUN mkdir -p /app/data /app/data/archives /app/logs \
    && chown -R cvcpkg:cvcpkg /app

USER cvcpkg

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8420

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8420/healthz || exit 1

# CVCPKG_SERVER_BIN resolves to the image's cvcpkg-server (poetry) or the
# prefix's (cvcpkg self-hosting).
CMD ["sh", "-c", \
     "exec ${CVCPKG_SERVER_BIN} run --host 0.0.0.0 --port 8420 --state-dir /app/data --workers 1"]

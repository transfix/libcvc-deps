# cvcpkg-server production environment
#
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to git.

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=cvcpkg
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
POSTGRES_DB=cvcpkg
POSTGRES_PORT=5432

# ── Backend ─────────────────────────────────────────────────────
BACKEND_PORT=8420

# Set to "1" to require auth tokens even for read/download endpoints
REQUIRE_AUTH_READS=

# Release tag (set by auto-deploy)
CVCPKG_RELEASE=dev

# Timezone
TIMEZONE=UTC

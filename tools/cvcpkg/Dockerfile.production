# Dockerfile for cvcpkg-server production
#
# Multi-stage build for smaller final image.
#
# Build:
#   docker build -f Dockerfile.production -t cvcpkg-server:latest .
#
# Run (requires CVCPKG_DATABASE_URL):
#   docker run -p 8420:8420 \
#     -e CVCPKG_DATABASE_URL=postgresql+asyncpg://... \
#     cvcpkg-server:latest

# ── Build stage ─────────────────────────────────────────────────
FROM python:3.12-slim AS builder

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        build-essential \
        libpq-dev \
        curl \
    && rm -rf /var/lib/apt/lists/*

ENV POETRY_HOME=/opt/poetry \
    POETRY_VERSION=1.8.2
RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

ENV POETRY_VIRTUALENVS_CREATE=false

COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-interaction --no-ansi --no-root --only main -E production

# ── Production stage ────────────────────────────────────────────
FROM python:3.12-slim

ARG CVCPKG_RELEASE=unknown
ENV CVCPKG_RELEASE=${CVCPKG_RELEASE}
ARG GITHUB_REPO=transfix/libcvc-deps
LABEL org.opencontainers.image.title="cvcpkg-server" \
      org.opencontainers.image.source="https://github.com/${GITHUB_REPO}" \
      org.opencontainers.image.version="${CVCPKG_RELEASE}"

WORKDIR /app

RUN apt-get update && apt-get install -y --no-install-recommends \
        libpq5 \
        curl \
    && rm -rf /var/lib/apt/lists/* \
    && useradd --create-home --shell /bin/bash cvcpkg

# Copy installed packages from builder
COPY --from=builder /usr/local/lib/python3.12/site-packages /usr/local/lib/python3.12/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin

# Copy application code
COPY --chown=cvcpkg:cvcpkg . .

# Install the package itself
RUN pip install --no-cache-dir -e ".[production]"

# Create data directories
RUN mkdir -p /app/data /app/data/archives /app/logs \
    && chown -R cvcpkg:cvcpkg /app

USER cvcpkg

ENV PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

EXPOSE 8420

HEALTHCHECK --interval=30s --timeout=10s --start-period=30s --retries=3 \
    CMD curl -f http://localhost:8420/healthz || exit 1

CMD ["cvcpkg-server", "run", \
     "--host", "0.0.0.0", \
     "--port", "8420", \
     "--state-dir", "/app/data", \
     "--workers", "2"]

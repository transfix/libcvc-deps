#!/usr/bin/expect -f
#
# Automated NetBSD 10.1 installation via serial console on Incus VM.
# This installs the base system and all distribution sets.
# After this, run fix-netbsd-postinstall.exp to configure serial/sshd/network,
# then netbsd-set-password.exp to set the root password.
#
# Prerequisites:
#   - VM "netbsd-build" created with --vm --empty, ISO attached
#   - VM should be STOPPED before running this script (script starts it)
#   - Run on the Incus host (not remotely)
#
# Usage: expect install-netbsd.exp
#
set timeout 300
log_file -noappend /tmp/netbsd-expect.log

system "incus start netbsd-build"
sleep 3

spawn incus console netbsd-build --force

# Wait for boot menu — SPACE stops the countdown timer
expect {
    "Choose an option" { send " " }
    "Boot normally" { send " " }
    "seconds" { send " " }
    timeout { puts "TIMEOUT at boot menu"; exit 1 }
}

# Select option 3 (Drop to boot prompt) — send "3" WITH Return
sleep 1
send "3\r"

expect {
    "help" { }
    timeout { puts "TIMEOUT at boot prompt"; exit 1 }
}

# Switch serial console
send "consdev com0\r"

# CRITICAL: After consdev com0, the bootloader redraws its entire banner.
# We must wait for the new prompt to appear after the redraw.
sleep 5
expect {
    "\n> " { }
    "\r\n> " { }
    timeout { puts "TIMEOUT after consdev"; exit 1 }
}

# Boot normally (will enter the sysinst installer)
send "boot\r"

# Wait for terminal emulation prompt
set timeout 300
expect {
    "terminal emulation" { }
    "Terminal type" { }
    timeout { puts "TIMEOUT terminal prompt"; exit 1 }
}
send "vt100\r"

# From here, the curses-based installer uses lettered menu items.
# Timing-based sends are needed because pattern matching on curses
# redraws is unreliable over serial.

# Language: a = English
sleep 10
send "a\r"

# Main menu: a = Install NetBSD to hard disk
sleep 10
send "a\r"

# Shall we continue? b = Yes
sleep 10
send "b\r"

# Select disk: a = sd0
sleep 10
send "a\r"

# Partition type: a = GPT (required for EFI boot on Incus VMs)
sleep 10
send "a\r"

# Partition sizing: b = Use default partition sizes
# NOTE: "a" enters the manual partition editor, "b" uses defaults
sleep 10
send "b\r"

# Accept partition sizes: x = Partition sizes ok
sleep 10
send "x\r"

# Last chance confirmation: b = Yes, install NetBSD
sleep 10
send "b\r"

# Wait for formatting and partitioning to complete
sleep 30

# Distribution set: a = Full installation (all sets including kernel)
send "a\r"

# Install selected sets: x = Install
sleep 10
send "x\r"

# Install medium: a = CD-ROM / DVD / install image media
sleep 10
send "a\r"

# Wait for all distribution sets to be extracted (17 sets)
set timeout 1200
expect {
    "Hit enter to continue" { }
    -re "(?i)hit enter" { }
    timeout { puts "TIMEOUT extraction"; exit 1 }
}
send "\r"

# Post-install configuration menu (actual menu letters):
#   a: Configure network
#   b: Set timezone
#   c: Change shell
#   d: Change root password
#   e: Enable installation of binary packages
#   f: Fetch and unpack pkgsrc
#   g: Enable sshd
#   h: Enable ntpd
#   o: Add a user
#   x: Finished configuring
sleep 15

# Configure network (DHCP on vioif0)
send "a\r"
sleep 8
send "a\r"     ;# First interface (vioif0)
sleep 5
# Accept defaults for all network prompts (DHCP, etc.)
send "\r"; sleep 3
send "\r"; sleep 3
send "\r"; sleep 3
send "\r"; sleep 3
send "\r"; sleep 3
send "\r"; sleep 3

# Set root password
send "d\r"
sleep 5
expect {
    "New password:" { }
    -re "(?i)new password" { }
    timeout { }
}
send "build1234567\r"
sleep 3
expect {
    "Retype new password:" { }
    -re "(?i)retype" { }
    timeout { }
}
send "build1234567\r"
sleep 5

# Enable sshd
send "g\r"
sleep 5

# Finished configuring
send "x\r"
sleep 10
send "\r"
sleep 10

# Reboot: d
send "d\r"
sleep 5

puts "\nNetBSD installation complete!"
exit 0

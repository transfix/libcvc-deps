#!/usr/bin/expect -f
#
# NetBSD post-install configuration fix via ISO rescue boot.
# Boots the install ISO in single-user mode, mounts the installed root,
# and writes configuration for: serial console (boot.cfg), sshd, DHCP
# networking, and serial getty.
#
# Prerequisites:
#   - VM "netbsd-build" with base install complete (install-netbsd.exp)
#   - Install ISO still attached
#   - VM should be STOPPED before running this
#   - Run on the Incus host
#
# After this, run netbsd-set-password.exp to set the root password
# using NetBSD's native passwd command.
#
# Usage: expect fix-netbsd-postinstall.exp
#
set timeout 300
log_file -noappend /tmp/netbsd-fix.log

system "incus start netbsd-build"
sleep 3

spawn incus console netbsd-build --force

# Boot menu — stop countdown
expect {
    "Choose an option" { send " " }
    "Boot normally" { send " " }
    "seconds" { send " " }
    timeout { puts "TIMEOUT at boot menu"; exit 1 }
}

# Drop to boot prompt
sleep 1
send "3\r"

expect {
    "help" { }
    timeout { puts "TIMEOUT at boot prompt"; exit 1 }
}

# Switch to serial console
send "consdev com0\r"

# Wait for redrawn banner
sleep 5
expect {
    "\n> " { }
    "\r\n> " { }
    timeout { puts "TIMEOUT after consdev"; exit 1 }
}

# Boot single-user from ISO
send "boot -s\r"

set timeout 300
expect {
    "Enter pathname of shell" {
        send "\r"
        sleep 3
    }
    timeout { puts "TIMEOUT waiting for shell"; exit 1 }
}

expect {
    -re "\n# $" { }
    -re "\r\n# " { }
    "# " { }
    timeout { puts "TIMEOUT at shell prompt"; exit 1 }
}

# Create writable /tmp (ISO root is read-only cd9660)
send "mount -t tmpfs tmpfs /tmp\r"
expect "# "
sleep 1

# fsck the installed root so it mounts read-write
send "fsck -y /dev/dk1\r"
expect "# "
sleep 5

# Mount the installed root
send "mount /dev/dk1 /mnt\r"
expect "# "
sleep 2

# ---- Configure serial console in bootloader ----
send "cat > /mnt/boot.cfg << 'EOF'\r"
expect "> "
send "menu=Boot normally:rndseed /var/db/entropy-file;boot\r"
expect "> "
send "menu=Boot single user:rndseed /var/db/entropy-file;boot -s\r"
expect "> "
send "menu=Drop to boot prompt:prompt\r"
expect "> "
send "default=1\r"
expect "> "
send "timeout=5\r"
expect "> "
send "consdev=com0,115200\r"
expect "> "
send "EOF\r"
expect "# "
sleep 1

# ---- Configure rc.conf (sshd + DHCP) ----
send "cat > /mnt/etc/rc.conf << 'EOF'\r"
expect "> "
send "rc_configured=YES\r"
expect "> "
send "hostname=netbsd-build\r"
expect "> "
send "sshd=YES\r"
expect "> "
send "dhcpcd=YES\r"
expect "> "
send "ntpd=NO\r"
expect "> "
send "EOF\r"
expect "# "
sleep 1

# ---- DHCP for vioif0 (virtio NIC) ----
send "echo 'dhcp' > /mnt/etc/ifconfig.vioif0\r"
expect "# "
sleep 1

# ---- Enable serial getty on tty00 ----
send {sed -i 's|^tty00.*|tty00 "/usr/libexec/getty std.115200" vt100 on secure|' /mnt/etc/ttys}
send "\r"
expect "# "
sleep 1

# ---- Configure sshd ----
send "cat >> /mnt/etc/ssh/sshd_config << 'EOF'\r"
expect "> "
send "PermitRootLogin yes\r"
expect "> "
send "EOF\r"
expect "# "
sleep 1

# Sync and unmount
send "sync; sync\r"
expect "# "
sleep 3
send "umount /mnt\r"
expect "# "
sleep 1

send "halt -p\r"
sleep 5

puts "\nNetBSD post-install fix complete!"
exit 0

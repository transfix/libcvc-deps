#!/usr/bin/expect -f
#
# Set root password on NetBSD by booting from disk in single-user mode.
# Uses NetBSD's native passwd command which generates argon2id hashes
# (bcrypt hashes generated externally don't work with NetBSD 10's login).
#
# Prerequisites:
#   - VM "netbsd-build" with base install + post-install config done
#   - Install ISO should be REMOVED before running this
#   - VM should be STOPPED before running this
#   - Run on the Incus host
#
# Usage:
#   incus config device remove netbsd-build install-iso  # if still attached
#   incus stop netbsd-build --force
#   expect netbsd-set-password.exp
#
set timeout 300
log_file -noappend /tmp/netbsd-passwd.log

system "incus start netbsd-build"
sleep 3

spawn incus console netbsd-build --force

# Boot menu — stop countdown and pick single-user
expect {
    "Choose an option" { send " " }
    "Boot normally" { send " " }
    "seconds" { send " " }
    timeout { puts "TIMEOUT at boot menu"; exit 1 }
}

# Option 2 = Boot single user (from disk's boot.cfg)
sleep 1
send "2\r"

# Wait for single-user shell
set timeout 300
expect {
    "Enter pathname of shell" {
        send "\r"
        sleep 3
    }
    timeout { puts "TIMEOUT waiting for shell"; exit 1 }
}

expect {
    "# " { }
    timeout { puts "TIMEOUT at shell prompt"; exit 1 }
}

# Mount root read-write
send "mount -o rw /\r"
expect "# "
sleep 1

# Set password using passwd (generates native argon2id hash)
send "passwd root\r"
expect {
    "New Password:" { send "build1234567\r" }
    "New password:" { send "build1234567\r" }
    timeout { puts "TIMEOUT at passwd prompt"; exit 1 }
}

expect {
    "Retype New Password:" { send "build1234567\r" }
    "Retype new password:" { send "build1234567\r" }
    timeout { puts "TIMEOUT at retype prompt"; exit 1 }
}

expect "# "
sleep 1

# Verify hash format is argon2id (native NetBSD 10)
send "head -1 /etc/master.passwd\r"
expect "# "
sleep 1

# Continue to multi-user
send "exit\r"
sleep 2

# Wait for login prompt (multi-user reached)
set timeout 120
expect {
    "login:" {
        puts "\nMulti-user mode reached!"
    }
    timeout {
        puts "\nTimeout waiting for multi-user login"
    }
}

puts "\nNetBSD password set complete!"
exit 0

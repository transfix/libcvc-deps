#!/usr/bin/expect -f
#
# Fully automated OpenBSD 7.7 VM provisioning on Incus.
# Creates the VM, downloads and attaches the ISO, runs the installer,
# removes the ISO, reboots, and installs build tools.
#
# Usage:
#   expect provision-openbsd.exp [VM_NAME] [TARGET_NODE] [ISO_PATH]
#
# Examples:
#   expect provision-openbsd.exp
#   expect provision-openbsd.exp openbsd-test star-01
#   expect provision-openbsd.exp openbsd-test star-01 /tmp/openbsd.iso
#
# Defaults: VM=openbsd-build, target=unset (any node), ISO downloaded if missing
#

# --- Configuration ---
set vm_name   [lindex $argv 0]
set target    [lindex $argv 1]
set iso_path  [lindex $argv 2]

if {$vm_name eq ""} { set vm_name "openbsd-build" }
if {$iso_path eq ""} { set iso_path "/tmp/openbsd.iso" }

set iso_url "https://cdn.openbsd.org/pub/OpenBSD/7.7/amd64/install77.iso"
set root_pass "build123"
set user_name "builder"
set user_pass "build123"

# Helper: abort with message
proc die {msg} {
    puts "FATAL: $msg"
    exit 1
}

puts "=== Provisioning OpenBSD VM: $vm_name ==="

# --- Download ISO if needed ---
if {![file exists $iso_path]} {
    puts "\[1/6\] Downloading OpenBSD 7.7 ISO ..."
    set rc [catch {exec curl -fSL -o $iso_path $iso_url} msg]
    if {$rc != 0} {
        catch {file delete $iso_path}
        die "Failed to download ISO: $msg"
    }
} else {
    puts "\[1/6\] Using existing ISO: $iso_path"
}

# --- Create VM ---
puts "\[2/6\] Creating VM ..."
set init_cmd "incus init $vm_name --vm --empty -c limits.cpu=4 -c limits.memory=4GiB -c security.secureboot=false -d root,size=50GiB"
if {$target ne ""} {
    append init_cmd " --target $target"
}
set rc [catch {exec {*}$init_cmd} msg]
if {$rc != 0} {
    die "Failed to create VM: $msg"
}

# Attach ISO
exec incus config device add $vm_name install-iso disk source=$iso_path boot.priority=10

# Start VM
puts "\[3/6\] Starting VM and running installer ..."
exec incus start $vm_name
sleep 5

# --- Run installer via serial console ---
set timeout 120
log_file -noappend /tmp/openbsd-provision-$vm_name.log

spawn incus console $vm_name --force

expect {
    "boot>" { }
    timeout { die "TIMEOUT waiting for boot prompt" }
}
sleep 0.3
send "set tty com0\r"

expect {
    "boot>" { }
    timeout { die "TIMEOUT after set tty" }
}
sleep 0.3
send "boot\r"

set timeout 180
expect {
    "(I)nstall" { }
    timeout { die "TIMEOUT waiting for installer menu" }
}
send "I\r"

set timeout 60
expect {
    "Terminal type" { }
    timeout { die "TIMEOUT at terminal type" }
}
send "vt220\r"

expect {
    "System hostname" { }
    timeout { die "TIMEOUT at hostname" }
}
send "$vm_name\r"

expect {
    "Network interface to configure" { }
    timeout { die "TIMEOUT at network interface" }
}
send "vio0\r"

expect {
    "IPv4 address" { }
    timeout { die "TIMEOUT at IPv4" }
}
send "autoconf\r"

expect {
    "IPv6 address" { }
    timeout { die "TIMEOUT at IPv6" }
}
send "none\r"

expect {
    "Network interface to configure" { }
    timeout { die "TIMEOUT at network done" }
}
send "done\r"

expect {
    "Password for root" { }
    timeout { die "TIMEOUT at root password" }
}
send "$root_pass\r"

expect {
    "Password for root" { }
    timeout { die "TIMEOUT at root password confirm" }
}
send "$root_pass\r"

expect {
    "sshd" { }
    timeout { die "TIMEOUT at sshd" }
}
send "yes\r"

expect {
    -re "X Window|xenodm" { }
    timeout { die "TIMEOUT at X Window" }
}
send "no\r"

expect {
    "console to com0" { }
    timeout { die "TIMEOUT at console com0" }
}
send "yes\r"

expect {
    "speed should com0" { }
    timeout { die "TIMEOUT at com0 speed" }
}
send "115200\r"

# Note: "build" is a reserved username on OpenBSD — use "builder"
expect {
    "Setup a user" { }
    timeout { die "TIMEOUT at setup user" }
}
send "$user_name\r"

expect {
    "Full name" { }
    timeout { die "TIMEOUT at full name" }
}
send "Builder\r"

expect {
    "Password" { }
    timeout { die "TIMEOUT at user password" }
}
send "$user_pass\r"

expect {
    "Password" { }
    timeout { die "TIMEOUT at user password confirm" }
}
send "$user_pass\r"

expect {
    "root ssh login" { }
    timeout { die "TIMEOUT at root ssh login" }
}
send "yes\r"

expect {
    "timezone" { }
    timeout { die "TIMEOUT at timezone" }
}
send "UTC\r"

expect {
    "Which disk" { }
    timeout { die "TIMEOUT at disk selection" }
}
send "sd0\r"

expect {
    "Encrypt the root" { }
    timeout { die "TIMEOUT at encrypt" }
}
send "\r"

expect {
    -re "\\(W\\)hole|\\(G\\)PT|MBR" { }
    timeout { die "TIMEOUT at partition scheme" }
}
send "G\r"

expect {
    -re "\\(A\\)uto|layout" { }
    timeout { die "TIMEOUT at layout" }
}
send "A\r"

expect {
    "Location of sets" { }
    timeout { die "TIMEOUT at sets location" }
}
send "cd0\r"

expect {
    "Pathname" { }
    timeout { die "TIMEOUT at pathname" }
}
send "7.7/amd64\r"

expect {
    -re "Set name.*\]" { }
    timeout { die "TIMEOUT at set name" }
}
send "done\r"

expect {
    "without verification" { send "yes\r" }
    "without SHA256.sig" { send "yes\r" }
    "Continue without verification" { send "yes\r" }
    timeout { die "TIMEOUT at verification prompt" }
}

set timeout 900
expect {
    "Location of sets" { send "done\r" }
    timeout { die "TIMEOUT during set extraction (15 min)" }
}

set timeout 300
expect {
    "CONGRATULATIONS" { }
    timeout { die "TIMEOUT waiting for CONGRATULATIONS" }
}
send "\r"

expect {
    -re "\\(S\\)hell|\\(H\\)alt|\\(R\\)eboot|#" { }
    timeout { die "TIMEOUT at reboot prompt" }
}
send "R\r"

puts "\n\[4/6\] Installation complete, reconfiguring VM ..."

# --- Remove ISO and reboot from disk ---
sleep 5
catch {send "\x01q"}
catch {expect eof}
catch {wait}
sleep 2

catch {exec incus stop $vm_name --force}
sleep 3
catch {exec incus config device remove $vm_name install-iso}
exec incus start $vm_name

puts "\[5/6\] Waiting for VM to boot from disk ..."
sleep 60

# --- Install build tools via SSH ---
puts "\[6/6\] Installing build tools ..."

# Find the VM's IP
set ip ""
for {set i 0} {$i < 30} {incr i} {
    set raw [exec incus list $vm_name -f csv -c 4]
    if {[regexp {(\d+\.\d+\.\d+\.\d+)} $raw match ip]} {
        break
    }
    sleep 5
}

if {$ip eq ""} {
    puts "WARNING: Could not find VM IP, skipping tool install."
    puts "Install manually: ssh root@<IP> < setup-openbsd-tools.sh"
} else {
    # Use expect to SSH and install tools
    spawn ssh -o StrictHostKeyChecking=no -o PubkeyAuthentication=no root@$ip

    set timeout 30
    expect {
        "Terminal type?" {
            send "vt220\r"
            expect -re "#|\\$"
        }
        "assword" {
            send "$root_pass\r"
            expect {
                "Terminal type?" {
                    send "vt220\r"
                    expect -re "#|\\$"
                }
                -re "#|\\$" { }
                timeout { die "TIMEOUT at SSH login" }
            }
        }
        timeout { die "TIMEOUT connecting via SSH" }
    }

    set timeout 600
    send "pkg_add -I cmake git ninja pkgconf curl wget gmake autoconf-2.72p0 automake-1.17 libtool python-3.12.11 gcc-11.2.0p15 llvm\r"
    expect {
        -re "#|\\$" { }
        timeout { die "TIMEOUT during package installation (10 min)" }
    }
    sleep 2

    send "uname -sr; cmake --version | head -1; git --version; python3 --version\r"
    expect {
        -re "#|\\$" { }
        timeout { puts "TIMEOUT verifying tools" }
    }
    sleep 1

    send "exit\r"
    expect eof
}

puts ""
puts "=== OpenBSD VM ready ==="
puts "  Name:   $vm_name"
puts "  IP:     $ip"
puts "  SSH:    ssh root@$ip (password: $root_pass)"
puts "  User:   $user_name (password: $user_pass)"

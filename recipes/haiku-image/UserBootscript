#!/bin/sh
# Haiku ~/config/settings/boot/UserBootscript — runs (as the boot user)
# after every boot. Injected into the image by build.sh.
#
# Haiku already brings interfaces up with DHCP and socket-activates sshd via
# the launch_daemon, so this is mostly belt-and-suspenders + a one-time
# first-boot toolchain top-up. Long-running commands must be backgrounded.

# Belt-and-suspenders: make sure host keys exist and sshd is running.
ssh-keygen -A 2>/dev/null
if ! ps | grep -q '[s]shd'; then
    /bin/sshd 2>/dev/null &
fi

# One-time first-boot setup (guarded by a marker in the writable home).
MARKER=/boot/home/.cvcpkg-firstboot-done
if [ ! -e "$MARKER" ]; then
    # Top up the build toolchain from HaikuPorts (needs the network, which
    # DHCP brings up). Kept out of the image to keep the build reliable;
    # failures here are non-fatal and can be retried over SSH.
    pkgman install -y cmake ninja make gcc git python3 pip 2>/dev/null &
    touch "$MARKER"
fi

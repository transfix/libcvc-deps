diff -urN a/libs/process/include/boost/process/v2/exit_code.hpp b/libs/process/include/boost/process/v2/exit_code.hpp
--- a/libs/process/include/boost/process/v2/exit_code.hpp	2026-07-03 13:17:11.147641478 -0500
+++ b/libs/process/include/boost/process/v2/exit_code.hpp	2026-07-03 13:17:30.413345987 -0500
@@ -73,10 +73,14 @@
 namespace detail
 {
 constexpr native_exit_code_type still_active = 0x17f;
+#if !defined(__NetBSD__)
+// NetBSD's <sys/wait.h> WIF* macros aren't usable in constexpr contexts
+// (they cast through void*), so guard these static_asserts on non-NetBSD.
 static_assert(WIFSTOPPED(still_active), "Expected still_active to indicate WIFSTOPPED");
 static_assert(!WIFEXITED(still_active), "Expected still_active to not indicate WIFEXITED");
 static_assert(!WIFSIGNALED(still_active), "Expected still_active to not indicate WIFSIGNALED");
 static_assert(!WIFCONTINUED(still_active), "Expected still_active to not indicate WIFCONTINUED");
+#endif
 }
 

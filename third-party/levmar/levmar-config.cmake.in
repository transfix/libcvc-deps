@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
if(@USE_BLAS@)
  # Try clapack CONFIG first (wasm, Windows/vcpkg), then fall back to LAPACK.
  find_dependency(clapack CONFIG QUIET)
  if(NOT clapack_FOUND)
    find_dependency(OpenBLAS CONFIG QUIET)
    if(NOT OpenBLAS_FOUND)
      find_dependency(LAPACK)
    endif()
  endif()
endif()

include("${CMAKE_CURRENT_LIST_DIR}/levmar-targets.cmake")

set(levmar_INCLUDE_DIRS "${PACKAGE_PREFIX_DIR}/include")
set(levmar_LIBRARIES levmar::levmar)

check_required_components(levmar)

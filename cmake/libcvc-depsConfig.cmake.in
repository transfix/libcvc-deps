@PACKAGE_INIT@

# libcvc-depsConfig.cmake — marker config for a libcvc-deps install.
#
# Including this config does NOT call find_package() on any of the
# bundled dependencies. That is intentional: downstream projects
# (libcvc, volrover3, F2Dock, MolSurf, …) already drive their own
# find_package() calls with the components they care about; this
# config just lets them assert that they have been pointed at a
# known dep distribution.
#
# Usage in a downstream CMakeLists.txt:
#
#     find_package(libcvc-deps CONFIG REQUIRED)
#     find_package(Boost REQUIRED COMPONENTS thread filesystem system)
#     find_package(HDF5  REQUIRED COMPONENTS C CXX)
#     find_package(Qt6   REQUIRED COMPONENTS Core Gui Widgets)
#     find_package(VTK   REQUIRED)
#
# All of the find_package() calls above resolve against this same
# install prefix as long as CMAKE_PREFIX_PATH contains the extracted
# libcvc-deps directory.

set(LIBCVC_DEPS_VERSION   "@PROJECT_VERSION@")
set(LIBCVC_DEPS_ROOT_DIR  "${PACKAGE_PREFIX_DIR}")

# Convenience: prepend our root to CMAKE_PREFIX_PATH so subsequent
# find_package() calls in the same configure step automatically
# search here too. Harmless if the caller already passed it.
if(NOT "${LIBCVC_DEPS_ROOT_DIR}" IN_LIST CMAKE_PREFIX_PATH)
  list(PREPEND CMAKE_PREFIX_PATH "${LIBCVC_DEPS_ROOT_DIR}")
endif()

set(libcvc-deps_FOUND TRUE)

@PACKAGE_INIT@

# libcvc-depsConfig.cmake — backward-compatibility wrapper.
#
# This file exists so that downstream projects using:
#
#     find_package(libcvc-deps CONFIG REQUIRED)
#
# continue to work after the rename to cvcpkg.  It simply loads
# the cvcpkgConfig.cmake from the same prefix.
#
# New projects should use:
#
#     find_package(cvcpkg CONFIG REQUIRED)

# Find the real config in the same prefix.
find_package(cvcpkg CONFIG QUIET
  PATHS "${PACKAGE_PREFIX_DIR}"
  NO_DEFAULT_PATH)

if(cvcpkg_FOUND)
  set(LIBCVC_DEPS_VERSION   "${CVCPKG_VERSION}")
  set(LIBCVC_DEPS_ROOT_DIR  "${CVCPKG_ROOT_DIR}")
  set(libcvc-deps_FOUND     TRUE)
else()
  # Fallback: set the variables directly (standalone install)
  set(LIBCVC_DEPS_VERSION   "@PROJECT_VERSION@")
  set(LIBCVC_DEPS_ROOT_DIR  "${PACKAGE_PREFIX_DIR}")

  if(NOT "${LIBCVC_DEPS_ROOT_DIR}" IN_LIST CMAKE_PREFIX_PATH)
    list(PREPEND CMAKE_PREFIX_PATH "${LIBCVC_DEPS_ROOT_DIR}")
  endif()

  set(libcvc-deps_FOUND TRUE)
endif()

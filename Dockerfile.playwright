# Dockerfile for cvcpkg Playwright browser integration tests
#
# Uses the official Playwright image which bundles Chromium, Firefox,
# and WebKit along with all required system libraries.
#
# Build: docker build -f Dockerfile.playwright -t cvcpkg-playwright .
# Run:   docker run --rm --network cvcpkg-test cvcpkg-playwright

FROM mcr.microsoft.com/playwright/python:v1.52.0-noble

WORKDIR /app

# Install Poetry and project deps (no browser-incompatible extras needed)
ENV POETRY_HOME=/opt/poetry \
    POETRY_VERSION=1.8.2
RUN curl -sSL https://install.python-poetry.org | python3 - && \
    ln -s /opt/poetry/bin/poetry /usr/local/bin/poetry

ENV POETRY_VIRTUALENVS_CREATE=false

COPY pyproject.toml poetry.lock* ./
RUN poetry install --no-interaction --no-ansi --with dev -E server

COPY . .
# Pin playwright to the version this base image was built for. Unpinned,
# `pip install pytest-playwright` pulls whatever is current (1.62.0 as of
# 2026-09-08) and the `playwright install` below downloads a browser to match --
# Chrome for Testing 151 instead of the Chromium bundled here -- so the image tag
# becomes a lie and the browser changes underneath the suite whenever the layer
# cache is cold. That is what broke the three fetch-dependent tests in
# tests/integration/test_browser.py: the same commit passed on 2026-09-05 from a
# warm cache and failed on 2026-09-08 after a rebuild.
ARG PLAYWRIGHT_VERSION=1.52.0
RUN pip install --no-cache-dir -e ".[server]" && \
    pip install --no-cache-dir "playwright==${PLAYWRIGHT_VERSION}" pytest-playwright && \
    playwright install --with-deps chromium

ENV PYTHONPATH=/app

CMD ["pytest", "tests/integration/test_browser.py", "-v", "--tb=short", "--browser", "chromium"]

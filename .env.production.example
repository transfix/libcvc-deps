# cvcpkg-server production environment
#
# Copy this file to .env.production and fill in the values.
# NEVER commit .env.production to git.

# ── PostgreSQL ──────────────────────────────────────────────────
POSTGRES_USER=cvcpkg
POSTGRES_PASSWORD=CHANGE_ME_GENERATE_A_STRONG_PASSWORD
POSTGRES_DB=cvcpkg
POSTGRES_PORT=5432

# ── Backend ─────────────────────────────────────────────────────
BACKEND_PORT=8420

# IP address to bind the backend port on the host.
# Use 127.0.0.1 (default) when a local reverse proxy handles TLS.
# Use the host's LAN IP when the reverse proxy is on a different machine.
BACKEND_BIND_ADDR=127.0.0.1

# Set to "1" to require auth tokens even for read/download endpoints
REQUIRE_AUTH_READS=

# Release tag (set by auto-deploy)
CVCPKG_RELEASE=dev

# Timezone
TIMEZONE=UTC

# ── Security & limits ──────────────────────────────────────────
# Maximum upload size in bytes (default: 512 MiB = 536870912)
CVCPKG_MAX_UPLOAD_BYTES=1073741824

# Rate limit: max requests per minute for write endpoints (0 = disabled)
CVCPKG_RATE_LIMIT_RPM=300

# CORS allowed origins (comma-separated, empty = deny all cross-origin)
CVCPKG_CORS_ORIGINS=

# ── Mirror mode (optional) ─────────────────────────────────────
# Run this instance as a read-only mirror of an upstream cvcpkg-server.
# The backend pulls the upstream catalog every CVCPKG_MIRROR_SYNC_INTERVAL
# seconds and proxies/caches downloads through /v1/mirror/download/{filename}.
# Publish and other write endpoints return 403 while mirror mode is on.
# Leave CVCPKG_MIRROR_MODE empty for a primary/authoritative server.
CVCPKG_MIRROR_MODE=
CVCPKG_MIRROR_UPSTREAM=https://cvcpkg.org
CVCPKG_MIRROR_TOKEN=
CVCPKG_MIRROR_SYNC_INTERVAL=3600

# ── Logging ─────────────────────────────────────────────────────
# Set to "1" to enable structured JSON log output
CVCPKG_LOG_JSON=

# ── Sign in with tx.wtf (OIDC) ─────────────────────────────────
# Register the relying party on the IdP first:
#
#   txwtf register-oidc-client --name "cvcpkg.org" \
#       --redirect-uri https://cvcpkg.org/admin/oidc/callback \
#       --scopes "openid profile email groups"
#
# It prints client_id, and client_secret exactly once.  Leaving any of the
# four required values empty keeps OIDC dormant (/admin/oidc/login 404s) and
# the dashboard keeps its bearer-token login.
CVCPKG_OIDC_ISSUER=https://tx.wtf
CVCPKG_OIDC_CLIENT_ID=
CVCPKG_OIDC_CLIENT_SECRET=
CVCPKG_OIDC_REDIRECT_URL=https://cvcpkg.org/admin/oidc/callback
CVCPKG_OIDC_SCOPES=openid profile email groups
# Set explicitly. docker compose's `environment:` mapping SETS the key, so an
# unset variable reaches the server as "" rather than absent. The server now
# coalesces empty back to the default, but leaving it blank here hides which
# claim the group mapping actually reads.
CVCPKG_OIDC_GROUPS_CLAIM=groups

# Group -> role mapping.  These must be groups created for cvcpkg on the IdP:
# a group every account already holds (e.g. "user") is refused at startup,
# because it would make signing up equivalent to holding the role.
CVCPKG_OIDC_ADMIN_GROUPS=cvcpkg-admin
CVCPKG_OIDC_PUBLISHER_GROUPS=cvcpkg-publisher
CVCPKG_OIDC_READER_GROUPS=cvcpkg-reader

# Role for a user who authenticates but matches no group.  Empty = refuse the
# login.  "reader" gives them a named identity an org owner can add to a
# private org by handle, while seeing no more than an anonymous visitor does.
CVCPKG_OIDC_DEFAULT_ROLE=reader

# Session cookies carry Secure unless this is explicitly 0 (plain-http dev).
CVCPKG_COOKIE_SECURE=1
CVCPKG_SESSION_TTL_SECONDS=28800
